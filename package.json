{
  "name": "illimitable-chat",
  "version": "0.4.1",
  "private": true,
  "bin": {
    "illi": "src/main.ts"
  },
  "scripts": {
    "start": "./src/main.ts",
    "test": "ILLI_VENDORS=claude-api ILLI_PICK=claude-api:sonnet-5.5:medium:slow ILLI_COMPACTOR=claude-api:haiku-5.5:high:slow ILLI_JOBS=64 bun test --isolate",
    "check": "tsc -p .",
    "build": "bun build --compile --no-compile-autoload-bunfig --no-compile-autoload-dotenv --minify src/main.ts src/chat/Seeker.ts --outfile illi"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "pele": "1.7.0",
    "pelext": "github:4our4ace/pelext#v0.2.2",
    "prismjs": "1.30.0"
  }
}
